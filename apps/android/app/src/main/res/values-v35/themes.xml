<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15 draws a targetSdk 35 app edge to edge; the app opts out, so the WebView starts below the status
         bar, the keyboard resizes it and the bars keep the page's colour, as on earlier versions. -->
    <style name="Theme.Sigelo" parent="Base.Sigelo">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
