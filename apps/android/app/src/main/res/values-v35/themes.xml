<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15 draws a targetSdk 35 app edge to edge; the page lays out as on earlier versions
         (the action bar and the keyboard resize the WebView), so the app opts out. -->
    <style name="Theme.Sigelo" parent="@android:style/Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">@color/sigelo_blue</item>
        <item name="android:colorPrimaryDark">@color/sigelo_blue_dark</item>
        <item name="android:colorAccent">@color/sigelo_blue</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
