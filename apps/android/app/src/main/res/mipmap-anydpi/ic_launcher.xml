<?xml version="1.0" encoding="utf-8"?>
<!-- The icon of apps/gtk/io.sigelo.App.svg as an adaptive icon: the blue as the background, the
     ring and the check as the foreground (drawable/ic_launcher_foreground.xml). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/sigelo_blue" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
