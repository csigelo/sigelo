<!-- sigelo for Android (design/apps.md §8). minSdk 28 and targetSdk 35 are in app/build.gradle.
     Permissions: the network (the relay, a computer on the LAN), the camera (asked at the first scan
     or the first photo), the microphone (asked at the first voice message or call), notifications (asked when the page asks, Android 13+; a name only, never a
     message), and on Android 9 only the shared storage, for a received file to land in Downloads
     (asked at the first; later versions write there through MediaStore with no permission). One
     provider, not exported: the photo file a camera app writes (PhotoProvider). Push: one receiver and one service, exported to
     the user's UnifiedPush distributor (UnifiedPush); Built in push's service and its boot receiver (PushClient). No backup of anything:
     the identity, its contacts and ratchets stay on this phone. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- Stay connected (StayConnected): a foreground service of type specialUse while minimised; the battery exemption
         asked once, when the user turns the switch on or taps its row in Settings. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Voice calls (CallService, design/calls.md §4): a foreground service of type microphone for the call's duration,
         the audio mode and route (earpiece, speaker), the proximity lock at the ear, the ring's vibration. None of these
         shows a prompt; RECORD_AUDIO above is asked at the first call made or accepted. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- A call's network watched (CallService): Wi-Fi to mobile data restarts the call's path at once; Built in push
         (PushClient) reconnects on a new network. No prompt. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Built in push (PushClient, design/push.md §6): its service started again at boot and after an update. No prompt. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Android 11+ package visibility: without it resolveActivity finds no camera app even when one is there. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <!-- Push (UnifiedPush.java): the distributors installed, each a receiver of REGISTER. -->
        <intent>
            <action android:name="org.unifiedpush.android.distributor.REGISTER" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sigelo">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share into sigelo (0.1.20): one text, link, photo or file from another app (ACTION_SEND; several at once is
                 out of scope). MainActivity hands it to the page (SigeloBridge.shared), which asks which chat; no permission
                 is added: the sending app grants the read of that one URI. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <provider
            android:name=".PhotoProvider"
            android:authorities="io.sigelo.app.photos"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Stay connected: keeps this process (the page and its relay connection) alive while minimised; ends with the task. -->
        <service
            android:name=".StayConnected"
            android:exported="false"
            android:stopWithTask="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the end-to-end messaging connection open while the app is minimised, so messages arrive and calls can ring." />
        </service>

        <!-- Built in push (PushClient, design/push.md §6): one HTTPS stream to push.sigelo.ai while the push mode is Built in;
             not ended by a swipe-away (stopWithTask false), started again at boot and after an update (PushClient$Boot). -->
        <service
            android:name=".PushClient"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Holds one connection to the app's own push server, so a waiting end-to-end message wakes the app without Google services." />
        </service>
        <receiver
            android:name=".PushClient$Boot"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Push (UnifiedPush.java, design/push.md §1 B): the distributor's broadcasts, each checked against our token, and
             the service it binds before a message so the wake may start StayConnected. Exported: the distributor is
             another app; neither holds anything. -->
        <receiver
            android:name=".UnifiedPush"
            android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
                <action android:name="org.unifiedpush.android.connector.TEMP_UNAVAILABLE" />
                <action android:name="org.unifiedpush.android.connector.MESSAGE" />
            </intent-filter>
        </receiver>
        <service
            android:name=".UnifiedPush$Raise"
            android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.RAISE_TO_FOREGROUND" />
            </intent-filter>
        </service>
        <!-- A voice call (CallService): in the foreground while a call lasts, started from the activity at Call or Accept;
             its notification's Hang up comes back to it. Not exported, ends with the task. -->
        <service
            android:name=".CallService"
            android:exported="false"
            android:stopWithTask="true"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
