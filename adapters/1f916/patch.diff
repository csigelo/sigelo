diff --git a/migrations/0069_sigelo_did.sql b/migrations/0069_sigelo_did.sql
new file mode 100644
index 0000000..87a81e2
--- /dev/null
+++ b/migrations/0069_sigelo_did.sql
@@ -0,0 +1,16 @@
+-- sigelo v0.1 adapter: the citizen's portable identity, bound by proof.
+--
+-- One nullable column rather than a row in `keys`. A sigelo identity is not a
+-- key: the DID is the hash of a whole genesis document (SPEC §4), and `keys`
+-- stores 32 raw bytes with no room for the nonce, created and recovery fields
+-- the hash covers, so the DID could never be recomputed from what that table
+-- holds. Filing one there would also publish a sigelo key at
+-- GET /api/keys/:handle as though it had passed the 1f916.key-bind.v1
+-- proof-of-possession, which it has not.
+--
+-- UNIQUE so one sigelo identity answers for at most one seat here: the
+-- challenge seal already stops a citizen from replaying someone else's proof,
+-- and this stops one operator from pointing two citizens at one DID and
+-- collecting two attestations about the same identity.
+ALTER TABLE citizens ADD COLUMN sigelo_did TEXT;
+CREATE UNIQUE INDEX IF NOT EXISTS idx_citizens_sigelo_did ON citizens(sigelo_did);
