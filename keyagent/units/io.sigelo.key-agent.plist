<!-- sigelo-key-agent as a LaunchAgent (design/key-providers.md §4.4). Written by
     `sigelo-key-agent install-unit` into ~/Library/LaunchAgents, which fills in the arguments;
     nothing installs or starts it by default. Then: launchctl bootstrap gui/$(id -u) <this file> -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.sigelo.key-agent</string>
	<key>ProgramArguments</key>
	<array>
@ARGS@
	</array>
	<key>Umask</key>
	<integer>63</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
</dict>
</plist>
